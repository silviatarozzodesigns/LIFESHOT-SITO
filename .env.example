# ==============================================================
# LIFESHOT — Variabili d'ambiente
# Copia questo file in `.env.local` per lo sviluppo locale.
# Su Vercel, configura le stesse variabili in Project Settings → Environment Variables.
# ==============================================================

# --- Database (MongoDB Atlas) ---
# Locale:   mongodb://localhost:27017/lifeshot
# Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifeshot
MONGODB_URI=mongodb://localhost:27017/lifeshot

# --- Storage: Cloudflare R2 (S3-compatible) ---
# Se queste variabili sono ASSENTI o vuote, l'app salva i file in `public/uploads`
# (modalità sviluppo locale). Se sono presenti, usa automaticamente R2.
#
# ⚠️ CORS: l'upload admin fa PUT diretti dal browser al bucket (file fino a
# 5 GB). Sul bucket R2 → Settings → CORS Policy serve una regola tipo:
# [{ "AllowedOrigins": ["https://<dominio-del-sito>"],
#    "AllowedMethods": ["PUT"], "AllowedHeaders": ["content-type"] }]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pubblico del bucket (dominio custom o r2.dev), senza slash finale
# es. https://media.lifeshot.it
R2_PUBLIC_URL=

# --- Admin Dashboard ---
# Credenziali base per proteggere /admin (da sostituire con auth completa in futuro)
ADMIN_PASSWORD=changeme

# --- App ---
# URL pubblico del sito (usato per metadata/OG). In locale: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
